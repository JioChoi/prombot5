# Dev and prod both call the backend directly here, so CORS applies to both — the
# backend's ALLOWED_ORIGINS has to list the dev origin too. Delete this file (or
# blank the value) to go back to same-origin /api through Vite's proxy.
VITE_API=https://server.jio.is

# Where the ~1.1 GB generated index is served from. Empty means same-origin,
# which is what dev uses: the files sit in frontend/public and Vite serves them
# with Range support. The deployed site cannot carry them, so set this to the
# host that does — it must send CORS headers for prombot.net and honour Range.
VITE_DATA=
