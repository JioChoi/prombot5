# Dev and prod both call the backend directly here, so CORS applies to both — the
# backend's ALLOWED_ORIGINS has to list the dev origin too. Delete this file (or
# blank the value) to go back to same-origin /api through Vite's proxy.
VITE_API=https://server.jio.is

# Where the ~1.1 GB generated index is served from — the site cannot carry it.
# Hugging Face answers ranged requests through its CDN redirect and sends CORS,
# which is all this needs. Blank it to go back to same-origin, i.e. the copies
# in frontend/public that Vite serves in dev.
VITE_DATA=https://huggingface.co/Jio7/prombot/resolve/main
