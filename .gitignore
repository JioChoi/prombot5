# Secrets — PROXY_KEY/PROXY_URLS and the NovelAI key. Never commit these.
backend/.env
proxy/.env
token
.out

__pycache__/
node_modules/
frontend/dist/

# The generated index: ~1.1 GB, and two of these files are far past GitHub's
# 100 MB per-file limit. They are build artefacts of build_index.py,
# build_dict.py, build_subset.py and build_characters.py over the danbooru
# dump, and they get deployed as static assets rather than shipped in the repo.
data/
frontend/public/*
# ...except the character profiles: 540 KB, and the browser must get exactly the
# columns this build's parser expects, so it ships with the site rather than
# from the data host.
!frontend/public/characters.csv.gz

# Same reason: the browser fetches these two from its own origin, so they have
# to ship with the site rather than from the data host. 4 KB and 8 KB.
!frontend/public/tag-requires.csv.gz
!frontend/public/prombot-nai.user.js

# The reference pictures pick_picture.py chose: ~28k webp, ~20 KB each. They
# are deployed to the data host beside the index, not carried in the repo.
character_dict/**/*.webp
.vercel
.env*
